# Server-only settings. None of these may use the NEXT_PUBLIC_ prefix.
# Restricted application role (perkkeep_app), pooled connection. Never the owner role.
PERKKEEP_DATABASE_URL=
# Neon managed auth (server side). The cookie secret needs at least 32 characters.
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
# Comma-separated owner email addresses. Empty means nobody can open the ledger.
PERKKEEP_OWNER_EMAILS=
# Optional extra allowed origins for state-changing requests (Vercel URLs are added automatically).
PERKKEEP_ALLOWED_ORIGINS=
# Local development only: npm run local:postgres writes these to .env.local.
# PERKKEEP_AUTH_PROVIDER=test
# PERKKEEP_TEST_AUTH_SECRET=
