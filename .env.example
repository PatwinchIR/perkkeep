# Server-only settings. Never prefix these with NEXT_PUBLIC_.
# On Vercel, DATABASE_URL / DATABASE_URL_UNPOOLED come from the attached Neon store.
# Locally, copy them into an ignored .env.local (for example with `vercel env pull`).
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Neon Auth endpoint for this project (Neon Console → Auth → Configuration).
NEON_AUTH_BASE_URL=
# Optional; at least 32 characters. If unset, a key is derived from DATABASE_URL.
NEON_AUTH_COOKIE_SECRET=
# Comma-separated addresses allowed to sign up and open the ledger.
PERKKEEP_OWNER_EMAILS=
# Set to "allow" to accept name+tag@ aliases of listed addresses (separate test owners).
PERKKEEP_OWNER_PLUS_ALIASES=
