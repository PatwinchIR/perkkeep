{
  "name": "perkkeep",
  "version": "1.0.0",
  "description": "A private, history-preserving credit card benefits tracker",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3017",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3017",
    "test": "vitest run",
    "test:db": "vitest run tests/database.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:client": "node scripts/check-client-secrets.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run check:client",
    "format": "prettier --write src tests scripts docs *.ts *.mjs *.json README.md",
    "local:postgres": "node scripts/local-postgres.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "neon:provision": "node scripts/neon-provision.mjs",
    "neon:inspect": "node scripts/neon-inspect.mjs",
    "legacy:supabase:start": "supabase stack start --runtime native --eager",
    "legacy:supabase:stop": "supabase stack stop"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@neondatabase/auth": "0.7.0-beta",
    "@vercel/functions": "3.10.4",
    "lucide-react": "1.62.0",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "supabase": "2.122.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "better-auth": "1.7.14",
    "@better-auth/core": "1.7.14",
    "@better-auth/oauth-provider": "1.7.14",
    "zod": "4.6.7"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  }
}
